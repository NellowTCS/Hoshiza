# Public vars are baked into the static build. The deploy workflow fills these from
# the matching GitHub Actions secrets (PUBLIC_WORKER_URL / PUBLIC_APP_URL) if present,
# otherwise you can drop a .env file here locally before `npm run build`.
#
# PUBLIC_WORKER_URL defaults to the production Worker at
# https://hoshiza.neeljaiswal23.workers.dev when unset (see src/lib/config.ts).
# During development, set it to your local Worker in .env.development instead:
#
#   PUBLIC_WORKER_URL=http://localhost:8787

# Canonical origin of the deployed app. Defaults to https://nellowtcs.me/Hoshiza.
PUBLIC_APP_URL=https://nellowtcs.me/Hoshiza
